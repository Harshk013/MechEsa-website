.about-page { --about-progress: 0; position: relative; min-height: 100vh; overflow: clip; padding-top: 68px; background: radial-gradient(circle at 50% 0%, rgba(130,169,199,.045), transparent 34%), linear-gradient(180deg, var(--color-bg), var(--color-bg-deep)); }
.about-page__grid { position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: .75; mask-image: linear-gradient(to bottom, black, transparent 88%); }
.about-page__rail { position: fixed; z-index: 5; right: 18px; top: 50%; transform: translateY(-50%); display: grid; gap: 10px; width: 28px; color: var(--color-text-dim); font: 8px var(--font-mono); text-align: center; pointer-events: none; }
.about-page__rail > span { color: var(--color-blueprint); }
.about-page__rail div { display: grid; gap: 3px; justify-items: center; opacity: .42; transition: opacity .2s var(--ease-ui); }
.about-page__rail div.is-active { opacity: 1; color: var(--color-text); }
.about-page__rail i { display: block; width: 1px; height: 20px; background: var(--color-border-strong); position: relative; }
.about-page__rail div.is-active i::after { content:""; position:absolute; inset:0; background:var(--color-blueprint); box-shadow:0 0 10px rgba(130,169,199,.25); }
.about-page__rail b { font-weight: 400; }
.about-section { position: relative; z-index: 1; scroll-margin-top: 90px; padding-block: clamp(5rem, 10vw, 9rem); border-top: 1px solid var(--color-border); }
.about-hero { position: relative; z-index: 1; min-height: calc(100vh - 68px); display: grid; align-items: center; padding-block: clamp(4rem, 9vw, 8rem); }
.about-hero__inner { width: 100%; }
.about-hero__top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-border); }
.about-hero__layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(380px, .8fr); gap: clamp(2rem, 8vw, 9rem); align-items: center; padding-block: clamp(3.5rem, 8vw, 7rem); }
.about-hero__copy { max-width: 760px; }
.about-hero__copy > .technical-small { color: var(--color-blueprint); }
.about-hero h1 { margin: 1rem 0 1.4rem; font-size: clamp(5.5rem, 14vw, 13rem); line-height: .78; letter-spacing: -.075em; }
.about-hero p { max-width: 640px; margin: 0; color: var(--color-text-muted); font-size: clamp(1rem, 1.5vw, 1.25rem); line-height: 1.65; }
.about-hero__foot { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 2rem; color: var(--color-text-dim); }
.about-hero__foot > :last-child { justify-self: end; }
.identity-instrument { min-height: 430px; border: 1px solid var(--color-border-strong); background: linear-gradient(180deg, rgba(255,255,255,.025), rgba(255,255,255,.008)); box-shadow: var(--shadow-machined); }
.identity-instrument__frame { position: relative; height: 100%; min-height: 430px; margin: 12px; border: 1px solid var(--color-border); overflow: hidden; }
.reg { position:absolute; width:18px; height:18px; border-color:var(--color-blueprint); opacity:.75; }
.reg.tl{left:-1px;top:-1px;border-left:1px solid;border-top:1px solid}.reg.tr{right:-1px;top:-1px;border-right:1px solid;border-top:1px solid}.reg.bl{left:-1px;bottom:-1px;border-left:1px solid;border-bottom:1px solid}.reg.br{right:-1px;bottom:-1px;border-right:1px solid;border-bottom:1px solid}
.identity-instrument__label,.identity-instrument__stamp,.identity-instrument__index { position:absolute; font:9px var(--font-mono); letter-spacing:.12em; color:var(--color-text-dim); }
.identity-instrument__label{left:14px;top:12px}.identity-instrument__stamp{right:14px;bottom:14px;color:var(--color-blueprint);text-align:right}.identity-instrument__index{left:14px;bottom:14px}
.identity-instrument__geometry { position:absolute; inset:16% 12%; border:1px solid rgba(130,169,199,.16); background:repeating-linear-gradient(0deg,transparent 0 32px,rgba(130,169,199,.07) 33px 34px),repeating-linear-gradient(90deg,transparent 0 32px,rgba(130,169,199,.07) 33px 34px); }
.identity-instrument__geometry .circle { position:absolute; border:1px solid rgba(130,169,199,.45); border-radius:50%; }
.identity-instrument__geometry .c1{width:180px;height:180px;left:50%;top:50%;transform:translate(-50%,-50%)}.identity-instrument__geometry .c2{width:92px;height:92px;left:50%;top:50%;transform:translate(-50%,-50%)}.identity-instrument__geometry .shaft{position:absolute;left:50%;top:12%;bottom:12%;width:1px;background:var(--color-blueprint)}.identity-instrument__geometry .datum{position:absolute;left:8%;right:8%;height:1px;background:rgba(130,169,199,.3)}.identity-instrument__geometry .d1{top:27%}.identity-instrument__geometry .d2{top:72%}.identity-instrument__geometry b{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font:700 12px var(--font-mono);letter-spacing:.22em;color:var(--color-text)}
.about-section-head { display:grid; grid-template-columns:minmax(0,1fr) minmax(300px,.65fr); gap:1rem clamp(2rem,7vw,8rem); align-items:end; margin-bottom:clamp(2.5rem,5vw,4.5rem); }
.about-section-head .technical-label { grid-column:1/-1; }
.about-section-head h2 { margin:0; font-size:clamp(2.8rem,6.5vw,7rem); line-height:.88; letter-spacing:-.06em; }
.about-section-head p { margin:0; color:var(--color-text-muted); line-height:1.65; max-width:540px; }
.identity-layout { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(320px,.7fr); gap:clamp(2rem,7vw,8rem); align-items:stretch; }
.identity-statement h2 { margin:1rem 0 0; max-width:900px; font-size:clamp(4rem,8.7vw,9rem); line-height:.83; letter-spacing:-.07em; }
.identity-panel { display:flex; flex-direction:column; gap:1rem; min-height:320px; justify-content:flex-end; }
.identity-panel p { margin:0; font-size:clamp(1.2rem,2vw,1.7rem); line-height:1.25; color:var(--color-text); }
.identity-panel__support { color:var(--color-text-muted)!important; font-size:.92rem!important; line-height:1.65!important; }
.philosophy-layout { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(300px,.65fr); gap:1rem; }
.philosophy-rail { position:relative; display:grid; grid-template-columns:repeat(6,1fr); align-items:start; gap:0; padding:2.5rem 0; }
.philosophy-rail__line { position:absolute; left:8%; right:8%; top:3.1rem; height:1px; background:var(--color-border-strong); }
.philosophy-rail__line span { display:block; height:100%; background:var(--color-blueprint); transition:width .35s var(--ease-precision); }
.principle-node-wrap { position:relative; z-index:1; display:block; }
.principle-node { width:100%; display:grid; justify-items:center; gap:.7rem; border:0; padding:0 .5rem; background:transparent; color:var(--color-text-dim); text-align:center; }
.principle-node > span { font:9px var(--font-mono); }.principle-node i{width:12px;height:12px;border:1px solid var(--color-border-strong);background:var(--color-bg);transform:rotate(45deg);transition:transform .25s var(--ease-mechanical),background .2s var(--ease-ui),border-color .2s var(--ease-ui)}.principle-node strong{font:10px var(--font-mono);letter-spacing:.1em;transition:color .2s var(--ease-ui)}.principle-node:hover strong,.principle-node.is-selected strong{color:var(--color-text)}.principle-node.is-selected i{border-color:var(--color-blueprint);background:var(--color-blueprint);transform:rotate(45deg) scale(1.12)}
.principle-inspector { min-height:340px; display:flex; flex-direction:column; gap:1rem; }.principle-inspector__head{display:flex;justify-content:space-between;align-items:start;gap:1rem}.principle-inspector h3{margin:1rem 0 0;font-size:clamp(2rem,4vw,4rem);line-height:.9}.principle-inspector p{margin:0;color:var(--color-text-muted);line-height:1.7}.principle-inspector__output{display:flex;justify-content:space-between;gap:1rem;margin-top:auto;padding:1rem;border:1px solid var(--color-border);background:var(--color-bg-deep);font:9px var(--font-mono);letter-spacing:.1em}.principle-inspector__output strong{color:var(--color-text)}
.systems-layout { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(300px,.65fr); gap:1rem; }.systems-map{position:relative;min-height:640px;border:1px solid var(--color-border);background:radial-gradient(circle at 50% 50%,rgba(130,169,199,.06),transparent 44%),var(--color-panel-technical);overflow:hidden}.systems-map__frame{position:absolute;inset:18px;border:1px solid rgba(130,169,199,.12);pointer-events:none}.systems-map__frame .corner{position:absolute;width:18px;height:18px;border-color:var(--color-blueprint)}.systems-map__frame .tl{left:-1px;top:-1px;border-left:1px solid;border-top:1px solid}.systems-map__frame .tr{right:-1px;top:-1px;border-right:1px solid;border-top:1px solid}.systems-map__frame .bl{left:-1px;bottom:-1px;border-left:1px solid;border-bottom:1px solid}.systems-map__frame .br{right:-1px;bottom:-1px;border-right:1px solid;border-bottom:1px solid}.systems-map__frame b{position:absolute;top:12px;left:12px;font:8px var(--font-mono);letter-spacing:.12em;color:var(--color-text-dim)}.systems-map__axis{position:absolute;opacity:.2;background:var(--color-blueprint)}.systems-map__axis--x{left:5%;right:5%;top:50%;height:1px}.systems-map__axis--y{top:5%;bottom:5%;left:50%;width:1px}.systems-map__connections{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.systems-map__connections line{stroke:rgba(130,169,199,.24);stroke-width:.12;vector-effect:non-scaling-stroke}.system-node-wrap{position:absolute;transform:translate(-50%,-50%);z-index:2}.system-node{width:100px;min-height:74px;padding:.75rem;display:grid;align-content:center;gap:.4rem;border:1px solid var(--color-border);background:var(--color-panel);color:var(--color-text-dim);box-shadow:var(--shadow-machined);text-align:left;transition:transform .25s var(--ease-mechanical),border-color .2s var(--ease-ui),background .2s var(--ease-ui)}.system-node:hover,.system-node.is-selected{transform:translateY(-3px);border-color:var(--color-blueprint);background:var(--color-surface-elevated)}.system-node span{font:8px var(--font-mono);color:var(--color-blueprint)}.system-node i{display:block;width:7px;height:7px;border:1px solid currentColor;transform:rotate(45deg)}.system-node strong{font:9px var(--font-mono);letter-spacing:.06em;color:var(--color-text)}
.system-inspector{min-height:640px;display:flex;flex-direction:column;gap:1rem}.system-inspector__top{display:flex;justify-content:space-between;gap:1rem}.system-inspector h3{margin:1rem 0 0;font-size:clamp(2rem,4vw,4rem);line-height:.9}.system-inspector p{margin:0;color:var(--color-text-muted);line-height:1.7}.system-inspector__readout{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-top:auto;background:var(--color-border);border:1px solid var(--color-border)}.system-inspector__readout span{display:grid;gap:.5rem;padding:1rem;background:var(--color-bg-deep);font:8px var(--font-mono);letter-spacing:.1em;color:var(--color-text-dim)}.system-inspector__readout strong{color:var(--color-text);font-size:.7rem}
.transformation-track{position:relative;display:grid;grid-template-columns:repeat(5,1fr);gap:0;min-height:420px;padding:4rem 0 2rem;border:1px solid var(--color-border);background:linear-gradient(180deg,rgba(255,255,255,.025),rgba(255,255,255,.008));overflow:hidden}.transformation-track__datum{position:absolute;left:7%;right:7%;top:50%;height:1px;background:var(--color-border-strong)}.transformation-track__datum::before{content:"";position:absolute;inset:-3px 0;background:repeating-linear-gradient(90deg,transparent 0 47px,rgba(130,169,199,.18) 48px 49px)}.transformation-track__datum span{position:absolute;top:0;left:0;width:calc(var(--about-progress) * 100%);height:1px;background:var(--color-blueprint);transition:width .2s linear}.transformation-track__datum b{position:absolute;left:calc(var(--about-progress) * 100%);top:50%;width:18px;height:18px;transform:translate(-50%,-50%) rotate(45deg);border:1px solid var(--color-blueprint);background:var(--color-panel)}.transformation-stage{position:relative;z-index:1;display:grid;justify-items:center;align-content:center;gap:.9rem;min-width:0}.transformation-stage__plate{width:min(145px,80%);aspect-ratio:1;display:grid;place-items:center;position:relative;border:1px solid var(--color-border-strong);background:var(--color-panel);box-shadow:var(--shadow-machined)}.transformation-stage__plate::before{content:"";position:absolute;inset:8px;border:1px solid var(--color-border)}.transformation-stage__plate span{position:absolute;left:9px;top:8px;font:8px var(--font-mono);color:var(--color-blueprint)}.transformation-stage__plate strong{font:2.8rem var(--font-sans);font-weight:300;color:var(--color-text)}.transformation-stage__plate i{position:absolute;left:15%;right:15%;bottom:24%;height:1px;background:var(--color-blueprint);transform-origin:left;animation:about-scan 2.8s var(--ease-precision) infinite}.transformation-stage__plate small{position:absolute;bottom:9px;left:9px;right:9px;font:7px var(--font-mono);color:var(--color-text-dim);text-align:center}.transformation-stage h3{margin:0;font:11px var(--font-mono);letter-spacing:.12em}.transformation-stage__connector{position:absolute;right:-50%;top:50%;width:100%;height:1px;background:var(--color-border-strong);z-index:-1}.transformation-track__foot{position:absolute;left:1rem;right:1rem;bottom:.75rem;display:flex;justify-content:space-between;color:var(--color-text-dim);font:7px var(--font-mono);letter-spacing:.1em}
.loop-layout{display:grid;grid-template-columns:minmax(420px,.9fr) minmax(300px,.7fr);gap:clamp(2rem,8vw,9rem);align-items:center}.loop-ring{position:relative;width:min(580px,100%);aspect-ratio:1;margin:auto;border:1px solid var(--color-border);border-radius:50%;background:radial-gradient(circle,rgba(130,169,199,.055),transparent 48%)}.loop-ring::before,.loop-ring::after{content:"";position:absolute;inset:10%;border:1px dashed rgba(130,169,199,.2);border-radius:50%}.loop-ring::after{inset:24%;border-style:solid;opacity:.45}.loop-ring__core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:150px;aspect-ratio:1;display:grid;place-content:center;text-align:center;border:1px solid var(--color-blueprint);background:var(--color-panel);box-shadow:var(--shadow-machined)}.loop-ring__core span{font:8px var(--font-mono);color:var(--color-text-dim)}.loop-ring__core strong{font-size:2rem;line-height:1}.loop-ring__node{position:absolute;left:50%;top:50%;width:92px;min-height:62px;transform:translate(-50%,-50%) rotate(var(--loop-angle)) translateY(-220px) rotate(calc(var(--loop-angle) * -1));padding:.55rem;border:1px solid var(--color-border);background:var(--color-panel);color:var(--color-text-dim);text-align:left;box-shadow:var(--shadow-machined);transition:border-color .2s var(--ease-ui),background .2s var(--ease-ui),transform .25s var(--ease-mechanical)}.loop-ring__node:hover,.loop-ring__node.is-active{border-color:var(--color-blueprint);background:var(--color-surface-elevated)}.loop-ring__node span{display:block;font:8px var(--font-mono);color:var(--color-blueprint)}.loop-ring__node b{font:9px var(--font-mono);letter-spacing:.06em;color:var(--color-text)}.loop-inspector{min-height:330px;display:flex;flex-direction:column;gap:1rem}.loop-inspector h3{margin:1rem 0 0;font-size:clamp(2rem,4vw,4rem);line-height:.9}.loop-inspector p{margin:0;color:var(--color-text-muted);line-height:1.7}.loop-inspector > strong{font-size:1.5rem;color:var(--color-blueprint)}
.institution-plate{display:grid;grid-template-columns:.8fr 1.4fr 50px;min-height:400px;border:1px solid var(--color-border-strong);background:var(--color-panel-technical);box-shadow:var(--shadow-machined)}.institution-plate__id{display:flex;flex-direction:column;gap:.6rem;padding:clamp(1.5rem,4vw,3rem);border-right:1px solid var(--color-border)}.institution-plate__id strong{margin-top:auto;font-size:clamp(2rem,4vw,4rem);letter-spacing:-.05em}.institution-plate__id span{font:9px var(--font-mono);color:var(--color-text-dim);letter-spacing:.1em}.institution-plate__copy{display:flex;flex-direction:column;align-items:flex-start;gap:1rem;padding:clamp(1.5rem,4vw,4rem)}.institution-plate__copy h2{margin:auto 0 0;font-size:clamp(3rem,6vw,6.5rem);line-height:.84;letter-spacing:-.06em}.institution-plate__copy p{max-width:680px;margin:0;color:var(--color-text-muted);line-height:1.7}.institution-plate__datum{display:flex;flex-direction:column;justify-content:space-around;align-items:center;padding:1rem 0;border-left:1px solid var(--color-border);font:8px var(--font-mono);color:var(--color-text-dim)}.institution-plate__datum i{width:1px;flex:1;background:var(--color-border);margin:8px 0}
.about-manifesto{padding-block:clamp(6rem,13vw,12rem)}.manifesto-head{display:flex;justify-content:space-between;gap:1rem;align-items:center;padding-bottom:2rem;border-bottom:1px solid var(--color-border)}.manifesto-list{display:grid}.manifesto-line{display:grid;grid-template-columns:60px minmax(0,1fr) auto;gap:1rem;align-items:end;padding:clamp(1.2rem,2.2vw,2rem) 0;border-bottom:1px solid var(--color-border);opacity:calc(.35 + var(--about-progress) * .65);transform:translateX(calc((1 - min(1, max(0, (var(--about-progress) * 1.8) - (var(--manifesto-index) * .11)))) * -24px));transition:opacity .45s var(--ease-precision),transform .55s var(--ease-precision)}.manifesto-line span{font:9px var(--font-mono);color:var(--color-blueprint)}.manifesto-line strong{font-size:clamp(2rem,5.8vw,7rem);line-height:.86;letter-spacing:-.06em}.manifesto-line em{font:8px var(--font-mono);font-style:normal;letter-spacing:.08em;color:var(--color-text-dim);padding-bottom:.35rem;text-align:right}.about-handoff{padding-block:clamp(5rem,10vw,10rem)}.about-handoff__inner{display:flex;justify-content:space-between;align-items:end;gap:2rem;padding-top:2.5rem}.about-handoff h2{margin:.8rem 0 1rem;font-size:clamp(4rem,9vw,9rem);line-height:.8;letter-spacing:-.07em}.about-handoff p{margin:0;color:var(--color-text-muted)}
.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
@keyframes about-scan{0%,100%{transform:scaleX(.25);opacity:.25}45%{transform:scaleX(1);opacity:.8}70%{transform:scaleX(.45);opacity:.35}}
@media (max-width:1100px){.about-hero__layout,.identity-layout,.philosophy-layout,.systems-layout,.loop-layout{grid-template-columns:1fr}.identity-panel{min-height:260px}.system-inspector{min-height:340px}.loop-ring{width:min(520px,100%)}.institution-plate{grid-template-columns:.8fr 1.2fr 42px}.about-section-head{grid-template-columns:1fr}.about-section-head p{max-width:680px}.about-section-head .technical-label{grid-column:auto}}
@media (max-width:820px){.about-page__rail{display:none}.philosophy-rail{grid-template-columns:1fr;padding:0 0 0 2rem;gap:0}.philosophy-rail__line{left:7px;right:auto;top:0;bottom:0;width:1px;height:auto}.philosophy-rail__line span{width:1px!important;height:calc((var(--about-progress) * 0) + 50%)}.principle-node-wrap{display:block}.principle-node{grid-template-columns:36px 22px 1fr;justify-items:start;align-items:center;min-height:66px;text-align:left;padding:.3rem 0}.principle-node i{grid-column:2;grid-row:1}.principle-node strong{grid-column:3}.principle-node>span{grid-column:1;grid-row:1}.systems-map{min-height:560px}.system-node{width:88px;min-height:66px}.transformation-track{grid-template-columns:1fr;gap:1rem;padding:1.5rem}.transformation-track__datum{left:50%;right:auto;top:5%;bottom:5%;width:1px;height:auto}.transformation-track__datum span{width:1px;height:calc(var(--about-progress) * 100%)}.transformation-track__datum b{left:50%;top:calc(var(--about-progress) * 100%)}.transformation-stage{grid-template-columns:90px 1fr;justify-items:start;align-items:center;padding-left:1rem}.transformation-stage__plate{width:90px}.transformation-stage__connector{right:auto;left:44px;top:auto;bottom:-.5rem;width:1px;height:1rem}.transformation-track__foot{display:none}.institution-plate{grid-template-columns:1fr}.institution-plate__id{border-right:0;border-bottom:1px solid var(--color-border);min-height:220px}.institution-plate__copy{min-height:400px}.institution-plate__datum{display:none}.manifesto-line{grid-template-columns:42px 1fr}.manifesto-line em{grid-column:2;text-align:left}.about-handoff__inner{align-items:flex-start;flex-direction:column}}
@media (max-width:620px){.about-page{padding-top:66px}.about-hero{min-height:auto;padding-block:4rem 5rem}.about-hero__top{align-items:flex-start;flex-direction:column}.about-hero__layout{padding-block:3.5rem;gap:3rem}.about-hero h1{font-size:clamp(4.4rem,21vw,7rem)}.about-hero__foot{grid-template-columns:1fr auto;gap:1rem}.about-hero__foot > :last-child{display:none}.identity-statement h2{font-size:clamp(3.3rem,16vw,6rem)}.about-section{padding-block:4.5rem}.about-section-head h2{font-size:clamp(2.8rem,13vw,5.5rem)}.identity-panel{min-height:360px}.systems-map{min-height:500px}.system-node{width:76px;min-height:62px;padding:.55rem}.system-node strong{font-size:8px}.loop-ring{width:calc(100vw - 2rem);max-width:440px}.loop-ring__node{width:78px;transform:translate(-50%,-50%) rotate(var(--loop-angle)) translateY(-38vw) rotate(calc(var(--loop-angle) * -1))}.loop-ring__core{width:120px}.manifesto-line strong{font-size:clamp(2rem,10vw,4rem)}.manifesto-line{transform:none!important;opacity:1!important}.about-handoff h2{font-size:clamp(4rem,17vw,7rem)} }
@media (prefers-reduced-motion:reduce){.about-page *{scroll-behavior:auto!important}.about-page__rail div,.principle-node i,.system-node,.transformation-stage__plate i,.manifesto-line,.transformation-track__datum span,.transformation-track__datum b{transition:none!important;animation:none!important}.manifesto-line{opacity:1;transform:none}.transformation-track__datum span{width:100%}.transformation-track__datum b{left:100%}}
